<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Used for dependency and plugin version management only; tradeevo-core has no Spring dependency. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>com.tradeevo</groupId>
    <artifactId>tradeevo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TradeEvo</name>
    <description>Trading Strategy Evaluation &amp; Evolution Engine</description>

    <modules>
        <module>tradeevo-core</module>
        <module>tradeevo-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <picocli.version>4.7.7</picocli.version>
        <git-commit-id-plugin.version>9.0.1</git-commit-id-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tradeevo</groupId>
                <artifactId>tradeevo-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <tradeevo.examples>${maven.multiModuleProjectDirectory}/examples</tradeevo.examples>
                            <tradeevo.config>${maven.multiModuleProjectDirectory}/config</tradeevo.config>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
